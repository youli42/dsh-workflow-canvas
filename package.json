{
  "name": "dsh-workflow-canvas",
  "version": "1.5.5",
  "description": "A visual multi-agent workflow canvas for DeepSeek Harness — parallel subagents, conditional branching, controlled retry loops & Lead decision gates in the sidebar.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "skills",
    "icon.svg",
    "LICENSE",
    "README.md",
    "README.zh.md"
  ],
  "license": "MIT",
  "author": "Wasabi2575",
  "homepage": "https://github.com/Wasabi2575/dsh-workflow-canvas#readme",
  "bugs": {
    "url": "https://github.com/Wasabi2575/dsh-workflow-canvas/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "deepseek",
    "workflow",
    "multi-agent",
    "subagent",
    "canvas",
    "node-graph",
    "ai-agents",
    "agent-orchestration"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wasabi2575/dsh-workflow-canvas.git"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
