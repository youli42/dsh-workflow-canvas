{
  "name": "dsh-workflow-canvas",
  "version": "1.4.0",
  "description": "A visual subagent-workflow canvas for DeepSeek Harness, docked in the sidebar.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "skills",
    "icon.svg",
    "LICENSE",
    "README.md",
    "README.zh.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wasabi2575/dsh-workflow-canvas.git"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
